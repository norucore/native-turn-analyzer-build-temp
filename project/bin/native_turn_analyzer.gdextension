[configuration]
entry_symbol = "native_turn_analyzer_library_init"
compatibility_minimum = "4.6"
reloadable = false

[libraries]
macos.debug.arm64 = "macos/libnative_turn_analyzer.macos.template_debug.arm64.dylib"
macos.release.arm64 = "macos/libnative_turn_analyzer.macos.template_release.arm64.dylib"
windows.debug.x86_64 = "windows/native_turn_analyzer.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "windows/native_turn_analyzer.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "linux/libnative_turn_analyzer.linux.template_debug.x86_64.so"
linux.release.x86_64 = "linux/libnative_turn_analyzer.linux.template_release.x86_64.so"
